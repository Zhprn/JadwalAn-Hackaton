# ---------- Database (Supabase) ----------
DATABASE_URL=        # Supabase transaction pooler, port 6543, akhiri dengan ?pgbouncer=true&connection_limit=10&pool_timeout=30
DIRECT_URL=          # Postgres (Supabase session pooler, port 5432, untuk migrasi / db push)

# ---------- Auth ----------
JWT_SECRET=          # string acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_REFRESH_SECRET=  # string acak lain (berbeda dari JWT_SECRET)

# ---------- AI (Google Gemini) ----------
GEMINI_API_KEY=                          # dari https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite       # model agent spesialis (booking/info/support)
GEMINI_FAST_MODEL=gemini-3.5-flash-lite  # model router & ringkasan (pilih yang paling cepat)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.5-flash   # pool cadangan: otomatis pindah jika model penuh/overload/timeout
GEMINI_TIMEOUT_MS=15000                    # batas waktu per percobaan model (maks 30000)
GEMINI_MAX_ATTEMPTS=4                      # maksimal model yang dicoba per request

# ---------- Pembayaran (Midtrans QRIS) ----------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---------- Server ----------
PORT=4000
DISABLE_JOBS=false   # true = matikan job otomatis (expire booking, no-show, metrik)

# ---------- Seed admin pertama (npm run seed) ----------
SEED_ADMIN_EMAIL=admin@jadwalan.id
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin Jadwalan

# ---------- WhatsApp (scan QR di Dashboard → Pengaturan → WhatsApp) ----------
WA_SESSION_DIR=.wa-session   # folder sesi; di Docker/hosting pasang volume persisten di sini
WA_DISABLED=false            # true = jangan auto-connect saat server menyala
